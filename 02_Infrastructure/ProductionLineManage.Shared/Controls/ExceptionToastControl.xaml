<UserControl
    x:Class="ProductionLineManage.Shared.Controls.ExceptionToastControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="380"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.RenderTransform>
        <TranslateTransform X="420" />
    </UserControl.RenderTransform>

    <Border Style="{StaticResource ExceptionToastContainerStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Width="36"
                Height="36"
                Margin="0,0,12,0"
                VerticalAlignment="Top"
                Background="#1AE81123"
                CornerRadius="18">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource ExceptionToastAccentBrush}"
                    Text="!" />
            </Border>

            <StackPanel Grid.Column="1">
                <TextBlock Style="{StaticResource ExceptionToastTitleStyle}" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Style="{StaticResource ExceptionToastMessageStyle}" Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                <TextBlock Style="{StaticResource ExceptionToastTimeStyle}" Text="{Binding OccurredAtText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <Button
                Grid.Column="2"
                VerticalAlignment="Top"
                Click="CloseButton_Click"
                Style="{StaticResource ExceptionToastCloseButtonStyle}" />
        </Grid>
    </Border>
</UserControl>
