<UserControl
    x:Class="ProductionLineManage.Shared.Controls.DataAddressPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:ProductionLineManage.Shared.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="140"
    d:DesignWidth="500"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolTOVis" />
    </UserControl.Resources>
    <!--  根据通讯协议类型切换对应的数据地址格式  -->
    <Border
        BorderBrush="#DBDBDB"
        BorderThickness="1"
        CornerRadius="5">
        <Grid Margin="0,2" DataContext="{Binding RelativeSource={RelativeSource AncestorType=local:DataAddressPanel}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>
            <!--  地址输入区域  -->
            <!--  S7协议数据地址UI  -->
            <StackPanel
                Height="80"
                Orientation="Horizontal"
                Visibility="{Binding IsS7Visible, Converter={StaticResource boolTOVis}}">

                <TextBlock
                    Margin="5"
                    VerticalAlignment="Center"
                    Text="区域： " />
                <!--  I\Q\M\T\DB  -->
                <ComboBox
                    Height="30"
                    Margin="5"
                    ItemsSource="{Binding RegionTypes}"
                    SelectedItem="{Binding RegionSelectedItem}" />

                <!--  区域编号  -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7SerialNumberVisible, Converter={StaticResource boolTOVis}}">
                    <TextBlock VerticalAlignment="Center" Text="编号：" />
                    <local:NumberTextBox
                        Width="65"
                        Margin="5"
                        VerticalAlignment="Center"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding ReagionSerialNumber ,UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <!--  DB区string数据类型  -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7StringVisible, Converter={StaticResource boolTOVis}}">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="起始地址：" />
                    <!--  起始地址  -->
                    <local:NumberTextBox
                        Width="70"
                        Margin="5"
                        VerticalAlignment="Center"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding StringTypeStartAddress ,UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="长度：" />
                    <!--  长度  -->
                    <local:NumberTextBox
                        Width="70"
                        Margin="5"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding StringTypeLengthEnable}"
                        Style="{StaticResource TextBoxExtend}"
                        Text="{Binding StringTypeLength}"
                        Minimum="1"
                        Maximum="256"/>
                    <CheckBox
                        x:Name="DefaultLengthCheck"
                        Content="默认长度"
                        IsChecked="{Binding DefaultLengthIsChecked}" />
                </StackPanel>

                <!--  DB区其他数据类型  -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7OtherVisible, Converter={StaticResource boolTOVis}}">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7OtherStartByteVisible, Converter={StaticResource boolTOVis}}">
                        <TextBlock
                            Margin="5"
                            VerticalAlignment="Center"
                            Text="起始字节: " />
                        <!--  起始字节  -->
                        <local:NumberTextBox
                            Width="70"
                            Margin="0,5,5,5"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBoxExtend}"
                            Text="{Binding OtherTypeStartByte ,UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    
                    <!--  起始位，例如：DB1.DBX6.2中的2、M3.5中的5、I1.3中的3 ，根据需求显示或隐藏  -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7OtherStartBitVisible, Converter={StaticResource boolTOVis}}">
                        <TextBlock VerticalAlignment="Center" Text="起始位：" />
                        <hc:NumericUpDown
                            Width="60"
                            Margin="0,5,5,5"
                            VerticalAlignment="Center"
                            Maximum="7"
                            Minimum="0"
                            Value="{Binding OtherTypeStartBit}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!--  OPCUA协议数据地址UI  -->
            <DockPanel Height="80" Visibility="{Binding IsOPCUAVisible, Converter={StaticResource boolTOVis}}">
                <TextBlock
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    Text="区域： " />
                <!--  I\Q\M\T\DB  -->
                <ComboBox
                    Height="30"
                    Margin="5"
                    ItemsSource="{Binding RegionTypes}"
                    SelectedItem="{Binding RegionSelectedItem}" />

                <StackPanel>
                    <DockPanel Margin="5" Visibility="{Binding IsOPCUANodeRegionNameVisible, Converter={StaticResource boolTOVis}}">
                        <TextBlock
                            x:Name="LongestTextBox"
                            VerticalAlignment="Center"
                            Text="节点区域名称：" />
                        <TextBox Text="{Binding NodeRegionName}" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="5">
                        <TextBlock
                            Width="{Binding ActualWidth, ElementName=LongestTextBox}"
                            VerticalAlignment="Center"
                            Text="数据名称：" />
                        <TextBox Text="{Binding NodeDataName}" />
                    </DockPanel>
                </StackPanel>

            </DockPanel>

            <!--  地址预览显示  -->
            <Border
                Grid.Row="1"
                Height="30"
                VerticalAlignment="Top"
                CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="地址预览：" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding AddressPreview}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>



</UserControl>
