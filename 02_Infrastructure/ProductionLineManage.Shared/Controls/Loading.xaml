<UserControl
    x:Class="ProductionLineManage.Shared.Controls.Loading"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProductionLineManage.Shared.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="90"
    d:DesignWidth="60"
    Foreground="#409EFE"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Storyboard x:Key="sb" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="rt1" Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.3 0.7 0.7 0.3"
                    KeyTime="0:0:3"
                    Value="360" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="b1" Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.3"
                Storyboard.TargetName="rt2"
                Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.3 0.7 0.7 0.3"
                    KeyTime="0:0:3"
                    Value="360" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.3"
                Storyboard.TargetName="b2"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.1" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.6"
                Storyboard.TargetName="rt3"
                Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.3 0.7 0.7 0.3"
                    KeyTime="0:0:3"
                    Value="360" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.6"
                Storyboard.TargetName="b3"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.9"
                Storyboard.TargetName="rt4"
                Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.3 0.7 0.7 0.3"
                    KeyTime="0:0:3"
                    Value="360" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:0.9"
                Storyboard.TargetName="b4"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>

            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:1.2"
                Storyboard.TargetName="rt5"
                Storyboard.TargetProperty="Angle">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <SplineDoubleKeyFrame
                    KeySpline="0.3 0.7 0.7 0.3"
                    KeyTime="0:0:3"
                    Value="360" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames
                BeginTime="0:0:1.2"
                Storyboard.TargetName="b5"
                Storyboard.TargetProperty="Opacity">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.2" Value="1" />
                <DiscreteDoubleKeyFrame KeyTime="0:0:3" Value="1" />
                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource sb}" />
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Border
            Name="b1"
            Width="60"
            Height="60"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform x:Name="rt1" Angle="0" />
            </Border.RenderTransform>
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <Border
            Name="b2"
            Width="60"
            Height="60"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform x:Name="rt2" Angle="0" />
            </Border.RenderTransform>
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <Border
            Name="b3"
            Width="60"
            Height="60"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform x:Name="rt3" Angle="0" />
            </Border.RenderTransform>
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <Border
            Name="b4"
            Width="60"
            Height="60"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform x:Name="rt4" Angle="0" />
            </Border.RenderTransform>
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <Border
            Name="b5"
            Width="60"
            Height="60"
            Opacity="0"
            RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <RotateTransform x:Name="rt5" Angle="0" />
            </Border.RenderTransform>
            <Ellipse
                Width="8"
                Height="8"
                VerticalAlignment="Top"
                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Border>

        <TextBlock
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}" />
    </Grid>
</UserControl>
