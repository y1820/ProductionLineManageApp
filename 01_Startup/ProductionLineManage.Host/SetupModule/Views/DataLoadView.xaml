<UserControl
    x:Class="ProductionLineManage.Host.SetupModule.Views.DataLoadView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ProductionLineManage.Host.SetupModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    Height="100"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Border
            Padding="10,0,0,0"
            Background="#0F75FF"
            CornerRadius="5,5,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="White"
                Text="正在加载数据" />
        </Border>

        <ProgressBar
            Grid.Row="1"
            Margin="15,0,15,0"
            Value="{Binding ProgressValue}" />


        <TextBlock
            Grid.Row="2"
            Margin="10,0,10,0"
            Foreground="Green"
            Text="{Binding CurrentTask}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
