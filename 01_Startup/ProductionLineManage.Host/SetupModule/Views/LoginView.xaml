<UserControl
    x:Class="ProductionLineManage.Host.SetupModule.Views.LoginView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:ProductionLineManage.Host.SetupModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="700"
    Height="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  主体内容  -->
        <Grid Panel.ZIndex="1">
            <Grid.Effect>
                <!--  模糊度  -->
                <BlurEffect Radius="{Binding Blur}" />
                <!--  {Binding Blur}  -->
            </Grid.Effect>
            <!--  背景图片  -->
            <Grid.Background>
                <ImageBrush ImageSource="{StaticResource loginBackground}" />
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="330" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="90" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!--    -->
            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Top"
                FlowDirection="RightToLeft"
                Orientation="Horizontal">

                <Button
                    Width="35"
                    Height="35"
                    BorderThickness="0"
                    Command="{Binding ClosebtnCommand}"
                    Content="&#xe600;"
                    FontFamily="{StaticResource fontFamily1}"
                    Style="{StaticResource CloseButtonStyle}"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            </StackPanel>


            <!--  公司log  -->
            <Image
                Width="110"
                Height="60"
                Margin="15,15,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="{StaticResource companyLogo2}" />
            <!--  标题字  -->
            <TextBlock
                Grid.Column="1"
                Margin="0,0,30,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontFamily="{StaticResource fontFamily2}"
                FontSize="20"
                FontWeight="Bold"
                Foreground="#015efd"
                Text="欢迎使用 - 产线管理系统" />


            <!--  登录输入信息 用户名密码  -->
            <Border
                Grid.Row="1"
                Grid.Column="1"
                Padding="10,30">
                <StackPanel Orientation="Vertical">


                    <!--  账号输入框   Style="{StaticResource TextBoxExtend}"  -->
                    <hc:ComboBox
                        x:Name="user_tb"
                        Margin="10"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="登录用户名"
                        hc:InfoElement.Symbol="*"
                        hc:TitleElement.Title="用户名："
                        hc:TitleElement.TitlePlacement="Top"
                        hc:TitleElement.TitleWidth="60"
                        BorderBrush="#015efd"
                        FontSize="14"
                        IsEditable="True"
                        IsReadOnly="False"
                        ItemsSource="{Binding UserNames}"
                        SelectedItem="{Binding UserNameSelectedItem}" />


                    <!--  密码输入框  -->
                    <hc:PasswordBox
                        x:Name="Pwd"
                        Margin="10"
                        hc:InfoElement.Necessary="True"
                        hc:InfoElement.Placeholder="请输入密码"
                        hc:InfoElement.Symbol="*"
                        hc:TitleElement.Title="密码："
                        BorderBrush="#015efd"
                        FontSize="14"
                        IsSafeEnabled="False"
                        ShowEyeButton="True"
                        UnsafePassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />



                    <!--  记住密码，下次自动登录  -->
                    <StackPanel Margin="0,5" Orientation="Horizontal">
                        <CheckBox
                            x:Name="RememberPwdCheckBox"
                            Margin="25,0,0,0"
                            HorizontalAlignment="Left"
                            Content="记住密码"
                            IsChecked="{Binding IsRememberPwd}" />
                        <CheckBox
                            x:Name="AutoLoadCheckBox"
                            Margin="35,0,0,0"
                            Content="自动登录"
                            IsChecked="{Binding IsAutoLogin}" />

                        <TextBlock
                            Margin="35,0,0,0"
                            Cursor="Hand"
                            Foreground="#015efd"
                            Text="创建用户"
                            TextDecorations="Underline">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding CreateUserCommand}" MouseAction="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>

                    </StackPanel>


                    <!--  登录按钮  -->
                    <Button
                        Width="270"
                        Height="35"
                        Margin="0,10"
                        Background="#059AFF"
                        BorderThickness="0"
                        Command="{Binding LoginCommand}"
                        Content="登  录"
                        FontSize="14"
                        Foreground="White" />


                    <!--  更新错误提示信息  -->
                    <TextBlock
                        Foreground="red"
                        Text="{Binding ErrorInfo}"
                        TextWrapping="Wrap" />



                </StackPanel>
            </Border>
        </Grid>



        <!--  Login动画 等待更新检查  -->
        <Border
            Panel.ZIndex="2"
            Background="Transparent"
            Visibility="{Binding IsShowCheck, Converter={StaticResource BoolToVisibility}}">
            <!--  Login自定义控件动画  -->
            <c:Loading
                VerticalAlignment="Center"
                Foreground="Orange"
                Text="正在检查更新..." />

        </Border>


    </Grid>
</UserControl>
