<Window
    x:Class="ProductionLineManage.Host.SetupModule.Views.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dc="clr-namespace:ProductionLineManage.Host.SetupModule.ViewModels"
    xmlns:hc="clr-namespace:HandyControl.Controls;assembly=HandyControl"
    xmlns:local="clr-namespace:ProductionLineManage.Host.SetupModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="[views ]clr-namespace:DeviceModule;assembly=DeviceModule"
    Title="产线管理系统"
    Width="1900"
    Height="1000"
    Background="#F7F9FA"
    FontFamily="Microsft YeHei"
    Foreground="#333"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <!--  窗体样式：窗体无边框 和 右上角按钮无效 可以保留窗体拖放功能  标题栏高度=50  -->
        <WindowChrome
            CaptionHeight="50"
            NonClientFrameEdges="None"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  顶部标题栏  -->
        <Border Background="{StaticResource TitleBrush}">
            <Grid Grid.Row="0" Height="65">
                <!--  标题栏内容  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  左上角图标和标题  -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <!--  临时：异常测试  -->
                        <!--
                        <Button
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Padding="8,4"
                            Background="#E74C3C"
                            BorderThickness="0"
                            Command="{Binding TestExceptionCommand}"
                            Content="异常测试"
                            Cursor="Hand"
                            FontSize="12"
                            Foreground="White"
                            ToolTip="临时：触发 UI 线程异常，测试全局捕获与抽屉提示"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                        -->

                        <!--  公司log  -->
                        <Border
                            Height="35"
                            Margin="5,0,0,0"
                            Padding="1"
                            Background="Transparent">
                            <Image Width="100" Source="{StaticResource companyLogo}" />
                        </Border>

                        <!--  标题  -->
                        <TextBlock
                            Margin="35,0"
                            VerticalAlignment="Center"
                            FontSize="25"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="产线管理系统" />
                    </StackPanel>

                    <!--  菜单层级  -->
                    <StackPanel
                        Grid.Column="1"
                        Height="40"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <!--  其它设置菜单栏  -->
                        <Menu Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
                            <Menu.Resources>
                                <Style TargetType="MenuItem">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="Transparent" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Menu.Resources>

                            <MenuItem Visibility="Collapsed">
                                <MenuItem.Header>
                                    <TextBlock
                                        Cursor="Hand"
                                        FontFamily="{StaticResource fontFamily1}"
                                        FontSize="30"
                                        Foreground="White"
                                        Text="&#xe64f;" />
                                </MenuItem.Header>
                                <MenuItem Header="系统日志">
                                    <MenuItem.Icon>
                                        <TextBlock
                                            FontFamily="{StaticResource fontFamily1}"
                                            FontSize="15"
                                            Text="&#xe625;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="系统更新">
                                    <MenuItem.Icon>
                                        <TextBlock
                                            FontFamily="{StaticResource fontFamily1}"
                                            FontSize="15"
                                            Text="&#xe6aa;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="重新启动">
                                    <MenuItem.Icon>
                                        <TextBlock
                                            FontFamily="{StaticResource fontFamily1}"
                                            FontSize="15"
                                            Text="&#x10232;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="退出">
                                    <MenuItem.Icon>
                                        <TextBlock
                                            FontFamily="{StaticResource fontFamily1}"
                                            FontSize="15"
                                            Text="&#xeb6f;" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                        </Menu>
                    </StackPanel>
                    <!--  日志提醒和用户信息  -->
                    <StackPanel
                        Grid.Column="2"
                        Height="47"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <!--  软件提示信息  -->
                        <Grid>
                            <Button
                                Click="Message_btn"
                                Content="🔔"
                                Style="{StaticResource ButtonStyle1}" />
                            <!--  提示圆圈  -->
                            <Ellipse
                                Width="10"
                                Height="10"
                                Margin="13,13,0,0"
                                Fill="Red" />
                            <!--  提示消息数量  -->
                            <TextBlock
                                Width="10"
                                Height="10"
                                Margin="13,13,0,0"
                                Padding="2.5,0.5,0,0"
                                FontSize="8"
                                Foreground="White"
                                Text="1" />
                        </Grid>

                        <Button Content="📰" Style="{StaticResource ButtonStyle1}" />

                        <!--  头像（可做用户切换操作）  -->
                        <Border
                            x:Name="bor"
                            Width="47"
                            Height="47"
                            Margin="10,-2,0,0"
                            Background="AliceBlue"
                            CornerRadius="100"
                            Cursor="Hand"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="8"
                                    Opacity="0.3"
                                    ShadowDepth="0"
                                    Color="Black" />
                            </Border.Effect>

                            <Grid>
                                <Popup
                                    x:Name="pop"
                                    AllowsTransparency="True"
                                    Placement="Left"
                                    PlacementTarget="{Binding ElementName=bor}"
                                    StaysOpen="False">
                                    <Border
                                        Width="150"
                                        Height="110"
                                        Background="White"
                                        BorderBrush="#D0D0D0"
                                        BorderThickness="0.5"
                                        CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="8"
                                                Opacity="0.3"
                                                ShadowDepth="2"
                                                Color="Black" />
                                        </Border.Effect>
                                        <StackPanel Margin="10">
                                            <TextBlock FontWeight="Bold" Text="用户信息" />
                                            <TextBlock Text="{Binding LoginUserName, StringFormat=用户名：{0}}" />
                                            <Button Content="切换账号" />
                                            <Button Content="修改密码" />
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="用户" />

                            </Grid>


                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <BooleanAnimationUsingKeyFrames Storyboard.TargetName="pop" Storyboard.TargetProperty="IsOpen">
                                                <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True" />
                                            </BooleanAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="bor"
                                                Storyboard.TargetProperty="Width"
                                                To="49"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="bor"
                                                Storyboard.TargetProperty="Height"
                                                To="49"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="bor"
                                                Storyboard.TargetProperty="Width"
                                                To="47"
                                                Duration="0:0:0.1" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="bor"
                                                Storyboard.TargetProperty="Height"
                                                To="47"
                                                Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>

                        </Border>
                        <!--  登录用户名  -->
                        <TextBlock
                            x:Name="user"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="White"
                            Text="{Binding LoginUserName}" />
                        <TextBlock Width="200" />
                    </StackPanel>
                    <!--  右上角标题栏窗体操作按钮  -->
                    <StackPanel
                        Grid.Column="3"
                        Margin="0,0,10,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <!--  最小化  -->
                        <Button
                            Click="MinWindow_btn"
                            Content="&#xe629;"
                            Style="{StaticResource ControlButtonStyle}" />
                        <!--  最大化  -->
                        <Button
                            x:Name="MaxWind"
                            Click="MaxWindow_btn"
                            Content="&#xe60d;"
                            Style="{StaticResource ControlButtonStyle}" />
                        <!--  关闭窗体  -->
                        <Button
                            Click="CloseWindow_btn"
                            Content="&#xe600;"
                            Style="{StaticResource ControlButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>




        <!--  左侧菜单栏  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  主菜单  -->
            <ListBox
                Name="menu_list"
                Grid.Column="0"
                Background="#0D102C"
                BorderThickness="0"
                ItemsSource="{Binding MenuList}"
                SelectedIndex="0"
                SelectionMode="Single"
                Style="{x:Null}">
                <!--  集合样式  -->
                <ListBox.ItemContainerStyle>
                    <!--  样式类型为listBoxItem  -->
                    <Style TargetType="ListBoxItem">
                        <!--  集合的水平内容对齐设置为伸展  -->
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!--  字体颜色  -->
                        <!--<Setter Property="Foreground" Value="white" />-->
                        <!--  模板  -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border
                                        Name="border"
                                        Padding="7"
                                        Background="Transparent"
                                        CornerRadius="0">
                                        <ContentPresenter
                                            Name="content"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <!--  如果选择了集合项中的一个则更改背景颜色  -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#0F75FF" />
                                            <Setter Property="TextBlock.Foreground" Value="#FFF" />
                                        </Trigger>
                                        <!--  如果鼠标停留在控件上更改背景颜色  -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#212970" />
                                            <Setter Property="TextBlock.Foreground" Value="#000000" />
                                        </Trigger>

                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!--  主菜单数据集合  -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <!--  主菜单图标 字体  -->
                            <TextBlock
                                Margin="0,6,0,6"
                                HorizontalAlignment="Center"
                                FontFamily="{StaticResource fontFamily1}"
                                FontSize="22"
                                Foreground="#2DCCA3"
                                Text="{Binding Icon}" />
                            <!--  主菜单名称  -->
                            <TextBlock
                                Grid.Row="1"
                                FontSize="14"
                                Foreground="White"
                                Text="{Binding Header}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  子菜单  -->
            <ItemsControl
                Grid.Column="1"
                Margin="0,10,0,0"
                Background="#fafeff"
                ItemsSource="{Binding ElementName=menu_list, Path=SelectedItem.Children}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton
                            Command="{Binding DataContext.OpenViewCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="{Binding Header}"
                            GroupName="A"
                            Style="{StaticResource RadioButtonStyle1}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>


            <!--  主要视图界面  -->
            <ContentControl
                xmlns:p="http://prismlibrary.com/"
                Grid.Column="2"
                Margin="10"
                p:RegionManager.RegionName="MainRegion" />


            <!--  加载覆盖层（半透明黑色背景）  -->
            <Grid
                x:Name="LoadingOverlay"
                Grid.Column="2"
                Background="#80000000"
                Visibility="Collapsed">
                <!--  加载动画放在这里  -->
                <c:Loading
                    x:Name="loading"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="19"
                    Foreground="Orange"
                    Visibility="Collapsed" />
            </Grid>
        </Grid>

    </Grid>
</Window>
