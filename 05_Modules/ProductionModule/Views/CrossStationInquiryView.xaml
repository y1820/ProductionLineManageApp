<UserControl
    x:Class="ProductionModule.Views.CrossStationInquiryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="1200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="40"
            Margin="0,0,0,16"
            Padding="10"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="产品工位状态" />
        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="10,0,10,8"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Text="流水码" />
            <TextBox
                Width="338"
                Margin="8,0,0,0"
                FontSize="15"
                Text="{Binding FlowCodeFilter, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线" />
            <ComboBox
                Width="140"
                Margin="8,0,0,0"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="工位" />
            <ComboBox
                Width="180"
                Margin="8,0,0,0"
                DisplayMemberPath="DisplayText"
                FontSize="15"
                IsEnabled="{Binding IsStationEnabled}"
                ItemsSource="{Binding LineStations}"
                SelectedIndex="{Binding StationSelectedIndex}"
                SelectedItem="{Binding StationSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="型号" />
            <ComboBox
                Width="140"
                Margin="8,0,0,0"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Types}"
                SelectedIndex="{Binding TypeSelectedIndex}"
                SelectedItem="{Binding TypeSelectedItem}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="10,0,10,10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Text="过站状态" />
            <ComboBox
                Width="100"
                Margin="8,0,0,0"
                DisplayMemberPath="Display"
                FontSize="15"
                ItemsSource="{Binding StatusOptions}"
                SelectedIndex="{Binding StatusSelectedIndex}"
                SelectedItem="{Binding StatusSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="是否返修" />
            <ComboBox
                Width="80"
                Margin="8,0,0,0"
                DisplayMemberPath="Display"
                FontSize="15"
                ItemsSource="{Binding RepairOptions}"
                SelectedIndex="{Binding RepairSelectedIndex}"
                SelectedItem="{Binding RepairSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="起始时间" />
            <hc:DateTimePicker
                Width="170"
                Margin="8,0,0,0"
                FontSize="15"
                SelectedDateTime="{Binding QueryStartTime}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="结束时间" />
            <hc:DateTimePicker
                Width="170"
                Margin="8,0,0,0"
                FontSize="15"
                SelectedDateTime="{Binding QueryEndTime}" />

            <Button
                Width="88"
                Height="32"
                Margin="24,0,0,0"
                Command="{Binding SearchCommand}"
                Content="查询" />
            <Button
                Width="88"
                Height="32"
                Margin="12,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CellStyle="{StaticResource DataGridCellStyle1}"
                ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle1}"
                IsReadOnly="True"
                ItemsSource="{Binding Records}"
                SelectedItem="{Binding SelectedRecord, Mode=TwoWay}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding Id}"
                        Header="Id" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding FlowCode}"
                        Header="流水码" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TrayCode}"
                        Header="托盘号" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding StationName}"
                        Header="工位" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding ProductTypeName}"
                        Header="型号" />
                    <DataGridTextColumn
                        Width="80"
                        Binding="{Binding LineName}"
                        Header="产线" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding StatusText}"
                        Header="状态" />
                    <DataGridTextColumn
                        Width="70"
                        Binding="{Binding IsRepairText}"
                        Header="返修" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding RepairTargetStationName}"
                        Header="返修目标工位" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding RepairCount}"
                        Header="返修次数" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding UpdateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                        Header="更新时间" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding CreateTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                        Header="创建时间" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Column="1"
                Margin="8,0,0,0"
                Padding="16,12"
                Background="White"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel>
                    <TextBlock
                        Margin="0,0,0,12"
                        FontSize="16"
                        FontWeight="Bold"
                        Text="修改产品状态" />

                    <TextBlock
                        Margin="0,0,0,16"
                        FontSize="12"
                        Foreground="Gray"
                        Text="{Binding SelectedRecordHint}"
                        TextWrapping="Wrap" />

                    <TextBlock FontSize="14" Text="工位" />
                    <ComboBox
                        Margin="0,6,0,16"
                        DisplayMemberPath="DisplayText"
                        FontSize="14"
                        ItemsSource="{Binding EditStations}"
                        SelectedItem="{Binding EditStationSelectedItem}" />

                    <TextBlock FontSize="14" Text="状态" />
                    <ComboBox
                        Margin="0,6,0,24"
                        DisplayMemberPath="Display"
                        FontSize="14"
                        ItemsSource="{Binding EditStatusOptions}"
                        SelectedItem="{Binding EditStatusSelectedItem}" />

                    <Button
                        Height="36"
                        Command="{Binding ConfirmModifyCommand}"
                        Content="确认修改"
                        FontSize="14" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="4"
            Margin="8,0,8,8"
            Padding="10"
            Background="#F9F9F9"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="Gray"
                    Text="{Binding TotalCountText}" />

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="每页" />
                    <ComboBox
                        Width="72"
                        VerticalAlignment="Center"
                        FontSize="12"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}" />
                    <Button
                        Width="56"
                        Height="28"
                        Margin="12,0,0,0"
                        Command="{Binding FirstPageCommand}"
                        Content="首页" />
                    <Button
                        Width="56"
                        Height="28"
                        Margin="6,0,0,0"
                        Command="{Binding PreviousPageCommand}"
                        Content="上页" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding PageInfo}" />
                    <Button
                        Width="56"
                        Height="28"
                        Command="{Binding NextPageCommand}"
                        Content="下页" />
                    <Button
                        Width="56"
                        Height="28"
                        Margin="6,0,0,0"
                        Command="{Binding LastPageCommand}"
                        Content="末页" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
