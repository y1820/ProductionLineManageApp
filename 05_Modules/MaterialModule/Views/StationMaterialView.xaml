<UserControl
    x:Class="MaterialModule.Views.StationMaterialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1. 标题  -->
        <Border
            Height="40"
            Margin="0,0,0,20"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="工位物料配置" />
        </Border>

        <!--  2. 筛选条件  -->
        <StackPanel
            Grid.Row="1"
            Margin="10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Text="型号  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Types}"
                SelectedIndex="{Binding TypeSelectedIndex}"
                SelectedItem="{Binding TypeSelectedItem}" />

            <TextBlock
                Margin="35,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <TextBlock
                Margin="35,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="工位  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="DisplayText"
                FontSize="15"
                ItemsSource="{Binding Stations}"
                SelectedIndex="{Binding StationSelectedIndex}"
                SelectedItem="{Binding StationSelectedItem}" />

            <!--  新增按钮  -->
            <Button
                Height="auto"
                Margin="16,0,0,0"
                BorderThickness="0"
                Command="{Binding AddCommand}"
                Content="&#xe6f3;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />

            <!--  刷新按钮  -->
            <Button
                Height="auto"
                Margin="6,0,0,0"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                Content="&#x10232;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />
        </StackPanel>

        <!--  3. 工位物料列表  -->
        <ListView
            x:Name="lv"
            Grid.Row="2"
            Margin="10"
            ItemsSource="{Binding StationMaterials}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <ListView.Resources>
                <!--  编辑按钮样式  -->
                <Style x:Key="EditTextBlockStyle" TargetType="TextBlock">
                    <Setter Property="Width" Value="55" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Background" Value="#0F75FF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,7,0,0" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <!--  删除按钮样式  -->
                <Style
                    x:Key="DeleteTextBlockStyle"
                    BasedOn="{StaticResource EditTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter Property="Background" Value="#FF4642" />
                </Style>
            </ListView.Resources>

            <ListView.View>
                <GridView>
                    <!--  ID 列  -->
                    <GridViewColumn Width="60" Header="Id">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Id}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  型号名称  -->
                    <GridViewColumn Width="120" Header="型号名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding TypeName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  产线名称  -->
                    <GridViewColumn Width="120" Header="产线名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding LineName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  工位名称  -->
                    <GridViewColumn Width="120" Header="工位名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding StationName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  物料编码  -->
                    <GridViewColumn Width="120" Header="物料编码">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding MaterialCode}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  物料名称  -->
                    <GridViewColumn Width="150" Header="物料名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding MaterialName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  查询合格工位  -->
                    <GridViewColumn Width="120" Header="合格检验工位">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding CheckStationName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  顺序  -->
                    <GridViewColumn Width="80" Header="顺序">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Sequence}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  父物料  -->
                    <GridViewColumn Width="120" Header="父物料">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding ParentMaterialName}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  备注  -->
                    <GridViewColumn Width="150" Header="备注">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Remarks}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  操作列  -->
                    <GridViewColumn Width="150" Header="操作">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <!--  修改按钮  -->
                                    <TextBlock Style="{StaticResource EditTextBlockStyle}" Text="修改">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <!--  删除按钮  -->
                                    <TextBlock Style="{StaticResource DeleteTextBlockStyle}" Text="删除">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
