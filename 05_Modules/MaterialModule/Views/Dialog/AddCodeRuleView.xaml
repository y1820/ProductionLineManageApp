<UserControl
    x:Class="MaterialModule.Views.Dialog.AddCodeRuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="580"
    Height="500"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <c:TitleBarControl
            FontIcon="&#xe6f3;"
            ShowMaximizeButton="False"
            ShowMinimizeButton="False"
            TitleName="{Binding Title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,10,30,10">
                <StackPanel Orientation="Horizontal">
                    <!--  型号  -->
                    <DockPanel Margin="0,15,0,0">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                            <Run Text="型号:" />
                            <Run Foreground="Red" Text="*" />
                        </TextBlock>
                        <ComboBox
                            Width="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Types}"
                            SelectedIndex="{Binding TypeSelectIndex}"
                            SelectedItem="{Binding TypeSelectItem}" />
                    </DockPanel>

                    <!--  物料  -->
                    <DockPanel Margin="20,15,0,0">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                            <Run Text="物料:" />
                            <Run Foreground="Red" Text="*" />
                        </TextBlock>
                        <ComboBox
                            Width="200"
                            HorizontalAlignment="Left"
                            DisplayMemberPath="Name"
                            IsEnabled="{Binding IsMaterialEnabled}"
                            ItemsSource="{Binding Materials}"
                            SelectedIndex="{Binding MaterialSelectIndex}"
                            SelectedItem="{Binding MaterialSelectItem}" />
                    </DockPanel>
                </StackPanel>

                <!--  组号  -->
                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="组号:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <hc:NumericUpDown
                        Width="150"
                        Minimum="1"
                        Value="{Binding GroupNo}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="Gray"
                        Text="（同一物料下，同一组号的规则需同时满足）" />
                </DockPanel>

                <!--  规则类型  -->
                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="规则类型:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox
                        Width="200"
                        HorizontalAlignment="Left"
                        DisplayMemberPath="Value"
                        ItemsSource="{Binding RuleTypes}"
                        SelectedIndex="{Binding RuleTypeSelectIndex}"
                        SelectedItem="{Binding RuleTypeSelectItem}" />
                </DockPanel>

                <StackPanel Orientation="Horizontal">
                    <!--  起始位（仅中间内容验证时显示）  -->
                    <DockPanel Margin="0,15,0,0" Visibility="{Binding IsMiddleRule, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                            <Run Text="起始位:" />
                            <Run Foreground="Red" Text="*" />
                        </TextBlock>
                        <hc:NumericUpDown
                            Width="90"
                            Minimum="1"
                            Value="{Binding StartBit}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="Gray"
                            Text="（从第几位开始验证，从1开始计数）" />
                    </DockPanel>

                    <!--  长度（总长度验证时必填）  -->
                    <DockPanel Margin="20,15,0,0" Visibility="{Binding IsLengthRequired, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                            <Run Text="长度:" />
                            <Run Foreground="Red" Text="*" />
                        </TextBlock>
                        <hc:NumericUpDown
                            Width="90"
                            HorizontalAlignment="Left"
                            Minimum="1"
                            Value="{Binding Length}" />
                    </DockPanel>
                </StackPanel>


                <!--  规则内容（固定内容验证时显示）  -->
                <DockPanel Margin="0,15,0,0" Visibility="{Binding IsFixedContent, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="验证内容:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <TextBox
                        Height="60"
                        Text="{Binding RuleContent}"
                        TextWrapping="Wrap" />
                </DockPanel>

                <!--  动态内容映射（年/月/日验证时显示）  -->
                <StackPanel Visibility="{Binding IsDynamicContent, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel Margin="0,15,0,0">
                        <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                            <Run Text="动态映射:" />
                            <Run Foreground="Red" Text="*" />
                        </TextBlock>
                        <TextBox
                            Height="60"
                            Text="{Binding DynamicMappingText}"
                            TextWrapping="Wrap"
                            ToolTip="格式：{2025:8,2026:9,2027:0}" />
                    </DockPanel>
                    <TextBlock
                        Margin="107,5,0,0"
                        FontSize="11"
                        Foreground="Gray"
                        Text="示例：{2025:8,2026:9} 表示2025年对应字符8，2026年对应字符9" />
                </StackPanel>

                <!--  分隔线  -->
                <Border
                    Height="1"
                    Margin="0,20,0,0"
                    Background="#E0E0E0" />
                <!--  规则名称  -->
                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="规则名称:" />
                    </TextBlock>
                    <TextBox
                        Width="300"
                        HorizontalAlignment="Left"
                        Text="{Binding RuleName}" />
                </DockPanel>
                <!--  示例条码  -->
                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="示例条码:" />
                    <TextBox Text="{Binding ExampleCode}" />
                </DockPanel>

                <!--  是否启用  -->
                <DockPanel Margin="0,15,0,0">
                    <CheckBox
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Content="是否启用"
                        IsChecked="{Binding IsActive}" />
                </DockPanel>

                <!--  备注  -->
                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="备注:" />
                    <TextBox AcceptsReturn="True" Text="{Binding Remarks}" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Button
                Width="70"
                Height="35"
                Margin="150,0,0,13"
                Padding="8,3"
                HorizontalAlignment="Left"
                Command="{Binding AddCommand}"
                Content="新增"
                FontSize="13" />
            <Button
                Width="70"
                Height="35"
                Margin="0,0,150,13"
                Padding="8,3"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Content="取消"
                FontSize="13" />
        </Grid>
    </Grid>
</UserControl>