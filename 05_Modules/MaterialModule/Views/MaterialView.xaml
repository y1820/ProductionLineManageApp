<UserControl
    x:Class="MaterialModule.Views.MaterialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MaterialModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <!--  1.标题  -->
        <Border
            Height="40"
            Margin="0,0,0,20"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="物料管理" />
        </Border>
        <!--  2.型号筛选和新增按钮  -->
        <Grid Grid.Row="1">
            <StackPanel Margin="10" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,5,0"
                    VerticalAlignment="Center"
                    Text="型号:" 
                    FontSize="15"/>
                <ComboBox
                    FontSize="15"
                    Width="200"
                    DisplayMemberPath="Name"
                    ItemsSource="{Binding Types}"
                    SelectedIndex="{Binding TypeSelectedIndex}"
                    SelectedItem="{Binding TypeSelectedItem}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    Height="35"
                    Margin="0,0,36,5"
                    BorderThickness="0"
                    Command="{Binding AddCommand}"
                    Content="&#xe6f3;"
                    FontFamily="{StaticResource fontFamily1}"
                    FontSize="23"
                    Foreground="#1485FF" />
                <!--  刷新按钮  -->
                <Button
                    Height="35"
                    Margin="0,0,16,5"
                    BorderThickness="0"
                    Command="{Binding RefreshCommand}"
                    Content="&#x10232;"
                    FontFamily="{StaticResource fontFamily1}"
                    FontSize="23"
                    Foreground="#1485FF" />
            </StackPanel>
        </Grid>
        <!--  3.物料列表  -->
        <ListView
            x:Name="lv"
            Grid.Row="2"
            Margin="10"
            ItemsSource="{Binding Materials}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.Resources>
                <!--  操作按钮样式（可复用）  -->
                <Style x:Key="EditTextBlockStyle" TargetType="TextBlock">
                    <Setter Property="Width" Value="55" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Background" Value="#0F75FF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Padding" Value="0,7,0,0" />
                </Style>

                <Style
                    x:Key="DeleteTextBlockStyle"
                    BasedOn="{StaticResource EditTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter Property="Background" Value="#FF4642" />
                </Style>
            </ListView.Resources>
            <ListView.View>
                <GridView>
                    <!--  Id 列  -->
                    <GridViewColumn Width="70" Header="物料Id">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Id}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <!--  代号列  -->
                    <GridViewColumn Width="150" Header="物料代号">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Code}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  名称列  -->
                    <GridViewColumn Width="150" Header="物料名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Name}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  备注列（自动撑开剩余空间）  -->
                    <GridViewColumn Width="200" Header="备注">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Remarks}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  创建时间列  -->
                    <GridViewColumn Width="160" Header="创建时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding CreateTime}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  更新时间列  -->
                    <GridViewColumn Width="160" Header="更新时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding UpdateTime}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  操作列  -->
                    <GridViewColumn Width="250" Header="操作">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <!--  修改按钮  -->
                                    <TextBlock Style="{StaticResource EditTextBlockStyle}" Text="修改">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <!--  删除按钮  -->
                                    <TextBlock Style="{StaticResource DeleteTextBlockStyle}" Text="删除">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
