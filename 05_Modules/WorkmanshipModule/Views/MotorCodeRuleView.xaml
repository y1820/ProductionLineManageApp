<UserControl
    x:Class="WorkmanshipModule.Views.MotorCodeRuleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border
            Height="40"
            Margin="0,0,0,12"
            Padding="10"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="生成规则（按型号）" />
        </Border>
        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="型号：" />
            <ComboBox
                Width="180"
                Margin="8,0,16,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Types}"
                SelectedItem="{Binding SelectedType}" />
            <TextBlock VerticalAlignment="Center" Text="信息类型：" />
            <ComboBox
                Width="120"
                Margin="8,0,16,0"
                DisplayMemberPath="Display"
                ItemsSource="{Binding FilterCategoryOptions}"
                SelectedValue="{Binding FilterCategory}"
                SelectedValuePath="Value" />
            <CheckBox
                VerticalAlignment="Center"
                Content="启用规则"
                IsChecked="{Binding IsEnabled}" />
            <Button
                Margin="16,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="Bold"
                    Text="片段配置" />
                <Button
                    Margin="12,0,0,0"
                    Command="{Binding AddBindCommand}"
                    Content="添加代号" />
            </StackPanel>
            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                EnableRowVirtualization="False"
                ItemsSource="{Binding DisplayBindRows}">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SegmentCode, UpdateSourceTrigger=PropertyChanged}"
                        Header="代号" />
                    <DataGridTemplateColumn Width="140" Header="数据类型">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    DisplayMemberPath="Display"
                                    IsSynchronizedWithCurrentItem="False"
                                    ItemsSource="{Binding DataContext.SegmentTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding SegmentType, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Value" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="180" Header="固定信息">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox
                                    DisplayMemberPath="Display"
                                    IsSynchronizedWithCurrentItem="False"
                                    ItemsSource="{Binding DataContext.FixedInfoOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    SelectedValue="{Binding FixedSegmentId, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="Id">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SegmentType}" Value="5">
                                                    <Setter Property="IsEnabled" Value="True" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding PreviewValue}"
                        Header="数据值(预览)"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                        Header="备注" />
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button
                                    Command="{Binding DataContext.DeleteBindCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="删" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel Grid.Row="3" VerticalAlignment="Top">
            <TextBlock FontWeight="Bold" Text="组合公式（+ 连接）" />
            <TextBox Margin="0,4,0,8" Text="{Binding Formula, UpdateSourceTrigger=PropertyChanged}" />
            <ItemsControl ItemsSource="{Binding FormulaSegmentCodes}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Margin="0,0,4,0"
                            Command="{Binding DataContext.AppendSegmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Content="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Border
            Grid.Row="4"
            Margin="0,12,0,12"
            Padding="12"
            Background="#FFF8E1">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="模拟取号（不占号）" />
                <TextBlock Margin="0,4,0,8" Text="{Binding SimulateHint}" />
                <StackPanel Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,12,0"
                        Command="{Binding SimulateCommand}"
                        Content="模拟生成" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding PreviewSequence, StringFormat=模拟序号: {0}}" />
                    <TextBlock
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Text="{Binding PreviewCode, StringFormat=预览: {0}}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="5" Orientation="Horizontal">
            <Button
                Width="80"
                Command="{Binding SaveCommand}"
                Content="保存" />
        </StackPanel>
    </Grid>
</UserControl>

