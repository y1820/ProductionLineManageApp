<UserControl
    x:Class="WorkmanshipModule.Views.MotorCodeSequenceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border
            Height="40"
            Margin="0,0,0,16"
            Padding="10"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="序列号设置（按型号）" />
        </Border>
        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="520">
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="型号：" />
                    <ComboBox
                        Width="200"
                        Margin="8,0,0,0"
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Types}"
                        SelectedItem="{Binding SelectedType}" />
                </StackPanel>
                <TextBlock
                    Margin="0,0,0,12"
                    Foreground="#666"
                    Text="每个型号独立序列与位数配置；型号之间不共用序号。自增系数控制每次取号 +N。"
                    TextWrapping="Wrap" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="位数" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding DigitLength}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="起始值" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding StartValue}" />
                    <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        Text="自增系数" />
                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding Step}" />
                    <TextBlock
                        Grid.Row="3"
                        VerticalAlignment="Center"
                        Text="复位周期" />
                    <ComboBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,4"
                        ItemsSource="{Binding ResetCycleOptions}"
                        SelectedItem="{Binding ResetCycle}" />
                    <TextBlock
                        Grid.Row="4"
                        VerticalAlignment="Center"
                        Text="启用" />
                    <CheckBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="0,4"
                        IsChecked="{Binding IsEnabled}" />
                </Grid>
                <Border
                    Margin="0,12,0,12"
                    Padding="12"
                    Background="#F5F5F5">
                    <StackPanel>
                        <TextBlock Text="{Binding BucketKey, StringFormat=当前桶: {0}}" />
                        <TextBlock Text="{Binding CurrentValue, StringFormat=当前序号: {0}}" />
                        <TextBlock Text="{Binding NextValue, StringFormat=下一号预览: {0}}" />
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                    <Button
                        Width="80"
                        Margin="0,0,8,0"
                        Command="{Binding SaveCommand}"
                        Content="保存" />
                    <Button
                        Width="80"
                        Command="{Binding RefreshCommand}"
                        Content="刷新" />
                </StackPanel>
                <TextBlock
                    Margin="0,8,0,4"
                    FontWeight="Bold"
                    Text="手动调整" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="设置序列号：" />
                    <TextBox
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding ManualValueText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        Grid.Row="1"
                        VerticalAlignment="Center"
                        Text="设置原因：" />
                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,4"
                        Text="{Binding AdjustReason, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <Button
                        Width="100"
                        Margin="0,0,8,0"
                        Command="{Binding AdjustCommand}"
                        Content="设定序号" />
                    <Button
                        Width="100"
                        Command="{Binding ResetCommand}"
                        Content="强制复位" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
