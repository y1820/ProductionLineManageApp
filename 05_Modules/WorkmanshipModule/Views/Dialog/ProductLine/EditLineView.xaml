<UserControl
    x:Class="WorkmanshipModule.Views.Dialog.EditLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:WorkmanshipModule.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="600"
    Height="200"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="35" />
        </Grid.RowDefinitions>
        <!--  1 标题栏  -->
        <Border
            Height="30"
            Padding="5"
            Background="{StaticResource TitleBrush}"
            CornerRadius="5,5,0,0">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,5,0"
                        FontFamily="{StaticResource fontFamily1}"
                        FontSize="15"
                        Foreground="White"
                        Text="&#xe728;" />
                    <TextBlock Foreground="White" Text="{Binding Title}" />
                </StackPanel>

                <!--  右上角关闭窗口按钮  -->
                <Button
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding ClosebtnCommand}"
                    Content="&#xe600;"
                    FontFamily="{StaticResource fontFamily1}"
                    Foreground="White"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="bor2"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bor2" Property="Opacity" Value="0.7" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!--  2 主要内容  -->
        <Grid
            Grid.Row="1"
            Width="500"
            Height="120">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,10,0,0">
                <!--  ID标题  -->
                <TextBlock
                    Margin="36,0,7,0"
                    VerticalAlignment="Center"
                    Text="ID:" />
                <!--  ID内容  -->
                <TextBlock
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Text="{Binding LineInfo.Id}" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="0,10,0,0">
                <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                    <Run Text="产线名称:" />
                    <Run Foreground="Red" Text="*" />
                </TextBlock>
                <TextBox Text="{Binding LineInfo.Name}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding EditCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <DockPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock
                    Margin="33,0,7,0"
                    VerticalAlignment="Center"
                    Text="备注:" />
                <TextBox Text="{Binding LineInfo.Remarks}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding EditCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Grid>


        <!--  3 按钮  -->
        <Grid Grid.Row="2">
            <Button
                Width="70"
                Height="35"
                Margin="150,0,0,3"
                Padding="8,3"
                HorizontalAlignment="Left"
                Command="{Binding EditCommand}"
                Content="修改"
                FontSize="13" />
            <Button
                Width="70"
                Height="35"
                Margin="0,0,150,3"
                Padding="8,3"
                HorizontalAlignment="Right"
                Command="{Binding ClosebtnCommand}"
                Content="取消"
                FontSize="13" />
        </Grid>
    </Grid>
</UserControl>
