<UserControl
    x:Class="WorkmanshipModule.Views.Dialog.EditProcessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WorkmanshipModule.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    Height="520"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="AliceBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <!--  1.标题栏  -->
        <c:TitleBarControl
            FontIcon="&#xe728;"
            ShowMaximizeButton="False"
            ShowMinimizeButton="False"
            TitleName="{Binding Title}" />

        <!--  2.中间主要内容  -->
        <StackPanel Grid.Row="1" Margin="20">

            <!--  Id  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock
                    Margin="36,0,7,0"
                    VerticalAlignment="Center"
                    Text="ID:" />
                <TextBlock Text="{Binding Process.Id}" />
            </DockPanel>

            <!--  型号  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock Margin="36,0,7,0" VerticalAlignment="Center">
                    <Run Text="型号:" />
                    <Run Foreground="Red" Text="*" />
                </TextBlock>
                <ComboBox
                    ItemsSource="{Binding Types}"
                    SelectedIndex="{Binding TypeSelectIndex}"
                    SelectedItem="{Binding TypesSelectItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!--  产线  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock Margin="36,0,7,0" VerticalAlignment="Center">
                    <Run Text="产线:" />
                    <Run Foreground="Red" Text="*" />
                </TextBlock>
                <ComboBox
                    ItemsSource="{Binding Lines}"
                    SelectedIndex="{Binding LineSelectIndex}"
                    SelectedItem="{Binding LinesSelectItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!--  工位  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock Margin="8,0,7,0" VerticalAlignment="Center">
                    <Run Text="当前工位:" />
                    <Run Foreground="Red" Text="*" />
                </TextBlock>
                <ComboBox
                    ItemsSource="{Binding CanSelectStations}"
                    SelectedIndex="{Binding StationSelectIndex}"
                    SelectedItem="{Binding StationsSelectItem}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>

            <!--  上工位  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock
                    x:Name="cb1"
                    Margin="22,0,7,0"
                    VerticalAlignment="Center">
                    <Run Text="前工位:" />
                    <Run Foreground="Red" Text="*" />
                </TextBlock>
                <ComboBox
                    Width="240"
                    ItemsSource="{Binding WorkStationInfos}"
                    SelectedIndex="{Binding UpStationSelectIndex}"
                    SelectedItem="{Binding UpStationsSelectItem}">
                    <ComboBox.Style>
                        <Style BasedOn="{StaticResource ComboBoxBaseStyle}" TargetType="ComboBox">
                            <Setter Property="IsEnabled" Value="True" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=chb1}" Value="True">
                                    <Setter Property="SelectedIndex" Value="-1" />
                                    <Setter Property="IsEnabled" Value="False" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <CheckBox
                    x:Name="chb1"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Content="无前工位"
                    IsChecked="{Binding HaveUpStation}" />
            </DockPanel>


            <!--  顺序  -->
            <DockPanel Margin="0,15,30,0">
                <TextBlock
                    Margin="41,0,7,0"
                    VerticalAlignment="Center"
                    Text="顺序:" />
                <hc:NumericUpDown
                    Width="150"
                    HorizontalAlignment="Left"
                    Minimum="1"
                    Value="{Binding Process.Sequence}" />
            </DockPanel>

            <!--  是否允许重复工作  -->
            <DockPanel Margin="33,15,30,0">
                <CheckBox Content="是否允许重复工作:" IsChecked="{Binding Process.IsRepeatWork}" />
            </DockPanel>

            <!--  是否返修工位  -->
            <DockPanel Margin="33,15,30,0">
                <CheckBox Content="是否返修工位:" IsChecked="{Binding Process.IsRepairStation}" />
            </DockPanel>

            <!--  是否启用  -->
            <DockPanel Margin="33,15,30,0">
                <CheckBox Content="是否启用:" IsChecked="{Binding Process.IsEnable}" />
            </DockPanel>






        </StackPanel>


        <!--  3.最下方按钮  -->
        <Grid Grid.Row="2">
            <Button
                Width="70"
                Height="35"
                Margin="150,0,0,13"
                Padding="8,3"
                HorizontalAlignment="Left"
                Command="{Binding EditCommand}"
                Content=" 修改"
                FontSize="13" />
            <Button
                Width="70"
                Height="35"
                Margin="0,0,150,13"
                Padding="8,3"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                Content="取消"
                FontSize="13" />
        </Grid>


    </Grid>
</UserControl>
