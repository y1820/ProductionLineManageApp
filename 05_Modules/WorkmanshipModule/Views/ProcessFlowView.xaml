<UserControl
    x:Class="WorkmanshipModule.Views.ProcessFlowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:WorkmanshipModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:theme="clr-namespace:Microsoft.Windows.Themes;assembly=PresentationFramework.Aero2"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  资源字典  -->
        <ResourceDictionary>
            <!--  可存多个资源字典，资源合并  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1.标题  -->
        <Border
            Height="40"
            Margin="0,0,0,10"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="工艺流程" />
        </Border>

        <!--  2.选择条件  -->
        <StackPanel
            Grid.Row="1"
            Margin="10"
            Orientation="Horizontal">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Text="型号  " />
            <!--  型号下拉框  -->
            <ComboBox
                x:Name="cb"
                Width="150"
                FontSize="15"
                IsEnabled="{Binding LoadingVisbility, Mode=OneWay, Converter={StaticResource negateConvert}}"
                ItemsSource="{Binding Types}"
                SelectedIndex="{Binding TypeSelectedIndex}"
                SelectedItem="{Binding TypeSelectedItem}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock
                Margin="35,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线  " />
            <!--  产线下拉框  -->
            <ComboBox
                Width="150"
                FontSize="15"
                IsEnabled="{Binding LoadingVisbility, Mode=OneWay, Converter={StaticResource negateConvert}}"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  新增工艺流程按钮  -->
            <Button
                Height="auto"
                Margin="16,0,0,0"
                BorderThickness="0"
                Command="{Binding NewAddCommand}"
                Content="&#xe6f3;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />
            <!--  刷新按钮  -->
            <Button
                Height="auto"
                Margin="6,0,0,0"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                Content="&#x10232;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF"
                IsEnabled="{Binding IsRefreshing, Converter={StaticResource negateConvert}, Mode=OneWay}" />
        </StackPanel>


        <!--  3.集合内容  -->
        <ListView
            x:Name="lv"
            Grid.Row="2"
            Margin="10"
            ItemsSource="{Binding DisplayProcess}"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.IsDeferredScrollingEnabled="True"
            VirtualizingPanel.ScrollUnit="Pixel"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <!--  内部资源  -->
            <ListView.Resources>
                <!--  操作按钮样式（可复用）编辑按钮  -->
                <Style x:Key="EditTextBlockStyle" TargetType="TextBlock">
                    <Setter Property="Width" Value="55" />
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="Background" Value="#0F75FF" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="TextAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Padding" Value="0,7,0,0" />
                    <Setter Property="Cursor" Value="Hand" />
                </Style>
                <!--  删除按钮样式  -->
                <Style
                    x:Key="DeleteTextBlockStyle"
                    BasedOn="{StaticResource EditTextBlockStyle}"
                    TargetType="TextBlock">
                    <Setter Property="Background" Value="#FF4642" />
                </Style>
            </ListView.Resources>
            <!--  视图内容  -->
            <ListView.View>
                <GridView>
                    <!--  Id 列  -->
                    <GridViewColumn Width="70" Header="Id">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Id}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  工位列  -->
                    <GridViewColumn Width="350" Header="工位名称">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding StationDisplayText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  是否允许重复工作列  -->
                    <GridViewColumn Width="120" Header="是否允许重复工作">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsRepeatWork}"
                                    IsHitTestVisible="False" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  是否返修工位列  -->
                    <GridViewColumn Width="100" Header="返修工位">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsRepairStation}"
                                    IsHitTestVisible="False" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  顺序列  -->
                    <GridViewColumn Width="120" Header="顺序">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding Sequence}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  上工序列  -->
                    <GridViewColumn Width="120" Header="上工序">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding UpperStationDisplayText}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  是否启用列  -->
                    <GridViewColumn Width="120" Header="是否启用">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding IsEnable}"
                                    IsHitTestVisible="False" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  创建时间列  -->
                    <GridViewColumn Width="160" Header="创建时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding CreateTime}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  更新时间列  -->
                    <GridViewColumn Width="160" Header="更新时间">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding UpdateTime}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <!--  操作列  -->
                    <GridViewColumn>
                        <GridViewColumn.Header>
                            <TextBlock
                                Width="250"
                                Text="操作"
                                TextAlignment="Center" />
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="70,0,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <!--  修改按钮  -->
                                    <TextBlock Style="{StaticResource EditTextBlockStyle}" Text="修改">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.EditCommand, ElementName=lv}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                    <!--  删除按钮  -->
                                    <TextBlock Style="{StaticResource DeleteTextBlockStyle}" Text="删除">
                                        <TextBlock.InputBindings>
                                            <MouseBinding
                                                Command="{Binding DataContext.DeleteCommand, ElementName=lv}"
                                                CommandParameter="{Binding}"
                                                Gesture="LeftClick" />
                                        </TextBlock.InputBindings>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>
        <!--  3.加载中  -->
        <hc:LoadingCircle
            Grid.Row="2"
            Width="70"
            Height="70"
            Foreground="Orange"
            Visibility="{Binding LoadingVisbility, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

</UserControl>
