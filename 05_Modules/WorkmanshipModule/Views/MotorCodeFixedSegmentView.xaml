<UserControl
    x:Class="WorkmanshipModule.Views.MotorCodeFixedSegmentView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="500"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

            <RowDefinition Height="Auto" />

        </Grid.RowDefinitions>

        <Border
            Height="40"
            Margin="0,0,0,12"
            Padding="10"
            Background="White">

            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="固定信息设置（按型号）" />

        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal">

            <TextBlock VerticalAlignment="Center" Text="型号：" />

            <ComboBox
                Width="200"
                Margin="8,0,0,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding Types}"
                SelectedItem="{Binding SelectedType}" />

            <Button
                Margin="16,0,0,0"
                Command="{Binding AddRowCommand}"
                Content="添加固定信息" />

        </StackPanel>

        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            ItemsSource="{Binding Rows}">

            <DataGrid.Columns>

                <DataGridTextColumn
                    Width="*"
                    Binding="{Binding FixedValue, UpdateSourceTrigger=PropertyChanged}"
                    Header="固定信息" />
                <DataGridTemplateColumn Width="120" Header="用途">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox
                                DisplayMemberPath="Display"
                                ItemsSource="{Binding DataContext.UsageOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedValue="{Binding UsageType, UpdateSourceTrigger=PropertyChanged}"
                                SelectedValuePath="Value" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Width="160"
                    Binding="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                    Header="备注" />

                <DataGridTemplateColumn Width="80">

                    <DataGridTemplateColumn.CellTemplate>

                        <DataTemplate>

                            <Button
                                Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="删" />

                        </DataTemplate>

                    </DataGridTemplateColumn.CellTemplate>

                </DataGridTemplateColumn>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            Orientation="Horizontal">

            <Button
                Width="80"
                Margin="0,0,8,0"
                Command="{Binding SaveCommand}"
                Content="保存" />

            <Button
                Width="80"
                Command="{Binding RefreshCommand}"
                Content="刷新" />

        </StackPanel>

    </Grid>

</UserControl>


