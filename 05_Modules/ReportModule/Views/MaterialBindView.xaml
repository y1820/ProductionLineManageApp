<UserControl
    x:Class="ReportModule.Views.MaterialBindView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReportModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="1100"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Height="40"
            Margin="0,0,0,16"
            Padding="10"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="绑定物料查询" />
        </Border>

        <StackPanel
            Grid.Row="1"
            Margin="10,0,10,8"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="15" Text="型号" />
            <ComboBox
                Width="140"
                Margin="8,0,0,0"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Types}"
                SelectedIndex="{Binding TypeSelectedIndex}"
                SelectedItem="{Binding TypeSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线" />
            <ComboBox
                Width="140"
                Margin="8,0,0,0"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="工位" />
            <ComboBox
                Width="180"
                Margin="8,0,0,0"
                DisplayMemberPath="DisplayText"
                FontSize="15"
                IsEnabled="{Binding IsStationEnabled}"
                ItemsSource="{Binding LineStations}"
                SelectedIndex="{Binding StationSelectedIndex}"
                SelectedItem="{Binding StationSelectedItem}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="绑定状态" />
            <ComboBox
                Width="120"
                Margin="8,0,0,0"
                DisplayMemberPath="Display"
                FontSize="15"
                ItemsSource="{Binding BindStatusOptions}"
                SelectedIndex="{Binding BindStatusSelectedIndex}"
                SelectedItem="{Binding BindStatusSelectedItem}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="10,0,10,10"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="15" Text="流水码" />
            <TextBox
                Width="180"
                Margin="8,0,0,0"
                FontSize="15"
                Text="{Binding FlowCodeFilter, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="物料码" />
            <TextBox
                Width="180"
                Margin="8,0,0,0"
                FontSize="15"
                Text="{Binding MaterialCodeFilter, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Width="88"
                Height="32"
                Margin="24,0,0,0"
                Command="{Binding SearchCommand}"
                Content="查询" />
            <Button
                Width="88"
                Height="32"
                Margin="12,0,0,0"
                Command="{Binding RefreshCommand}"
                Content="刷新" />
            <Button
                Width="100"
                Height="32"
                Margin="12,0,0,0"
                Command="{Binding ExportCommand}"
                Content="导出Excel" />
        </StackPanel>

        <DataGrid
            Grid.Row="3"
            Margin="8"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CellStyle="{StaticResource DataGridCellStyle1}"
            ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle1}"
            IsReadOnly="True"
            ItemsSource="{Binding BindData}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="50" Binding="{Binding Id}" Header="Id" />
                <DataGridTextColumn Width="160" Binding="{Binding FlowCode}" Header="流水码" />
                <DataGridTextColumn Width="100" Binding="{Binding ProductTypeName}" Header="型号" />
                <DataGridTextColumn Width="80" Binding="{Binding LineName}" Header="产线" />
                <DataGridTextColumn Width="140" Binding="{Binding StationName}" Header="工位" />
                <DataGridTextColumn Width="120" Binding="{Binding BindMaterialName}" Header="物料名称" />
                <DataGridTextColumn Width="160" Binding="{Binding BindMaterialCode}" Header="物料码" />
                <DataGridTextColumn Width="80" Binding="{Binding BindStatusText}" Header="绑定状态" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding BindTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Header="绑定时间" />
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding UnbindTime, StringFormat=yyyy-MM-dd HH:mm:ss}"
                    Header="解绑时间" />
            </DataGrid.Columns>
        </DataGrid>

        <Border
            Grid.Row="4"
            Margin="8,0,8,8"
            Padding="10"
            Background="#F9F9F9"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="Gray"
                    Text="{Binding TotalCountText}" />

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <TextBlock
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="Gray"
                        Text="每页" />
                    <ComboBox
                        Width="72"
                        VerticalAlignment="Center"
                        FontSize="12"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding SelectedPageSize}" />
                    <Button
                        Margin="12,0,5,0"
                        Padding="8,5"
                        Command="{Binding FirstPageCommand}"
                        Content="首页" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding PreviousPageCommand}"
                        Content="上一页" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding PageInfo}" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding NextPageCommand}"
                        Content="下一页" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding LastPageCommand}"
                        Content="末页" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
