<UserControl
    x:Class="DeviceModule.Views.Dialog.ProtocolConnectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid MinHeight="44">
        <!--  S7  -->
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsS7Protocol, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="CPU类型:" />
            <ComboBox
                Width="100"
                Margin="0,0,10,0"
                ItemsSource="{Binding S7CpuTypes}"
                SelectedItem="{Binding S7CpuType}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="IP:" />
            <TextBox
                Width="160"
                Margin="0,0,10,0"
                Text="{Binding S7Ip}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="机架(rack):" />
            <hc:NumericUpDown
                Width="70"
                Margin="0,0,10,0"
                Maximum="7"
                Minimum="0"
                Value="{Binding S7Rack}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="插槽(slot):" />
            <hc:NumericUpDown
                Width="70"
                Maximum="31"
                Minimum="0"
                Value="{Binding S7Slot}" />
        </StackPanel>

        <!--  OPC UA  -->
        <StackPanel Visibility="{Binding IsOpcUaProtocol, Converter={StaticResource BoolToVisibility}}">
            <TextBox Text="{Binding OpcUaUrl}" ToolTip="格式: opc.tcp://192.168.0.1:4840" />
        </StackPanel>

        <!--  Modbus TCP  -->
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsModbusProtocol, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="IP:" />
            <TextBox
                Width="160"
                Margin="0,0,10,0"
                Text="{Binding ModbusIp}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="端口:" />
            <hc:NumericUpDown
                Width="90"
                Margin="0,0,10,0"
                Maximum="65535"
                Minimum="1"
                Value="{Binding ModbusPort}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="从站:" />
            <hc:NumericUpDown
                Width="70"
                Maximum="247"
                Minimum="1"
                Value="{Binding ModbusSlaveId}" />
        </StackPanel>

        <!--  TCP/IP  -->
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsTcpIpProtocol, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="IP:" />
            <TextBox
                Width="160"
                Margin="0,0,10,0"
                Text="{Binding TcpIpHost}" />
            <TextBlock
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="端口:" />
            <hc:NumericUpDown
                Width="90"
                Maximum="65535"
                Minimum="1"
                Value="{Binding TcpIpPort}" />
        </StackPanel>

        <!--  Simulator  -->
        <TextBlock
            VerticalAlignment="Center"
            Foreground="#666666"
            Text="模拟驱动无需配置连接地址"
            Visibility="{Binding IsSimulatorProtocol, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
