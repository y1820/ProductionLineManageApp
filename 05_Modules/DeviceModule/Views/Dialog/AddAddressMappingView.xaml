<UserControl
    x:Class="DeviceModule.Views.Dialog.AddAddressMappingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="550"
    Height="580"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <c:TitleBarControl
            FontIcon="&#xe6f3;"
            ShowMaximizeButton="False"
            ShowMinimizeButton="False"
            TitleName="{Binding Title}" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">
                <DockPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="产线:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox
                        DisplayMemberPath="Name"
                        ItemsSource="{Binding Lines}"
                        SelectedIndex="{Binding LineSelectIndex}"
                        SelectedItem="{Binding LineSelectItem}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="工位:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox
                        DisplayMemberPath="DisplayText"
                        IsEnabled="{Binding IsStationEnabled}"
                        ItemsSource="{Binding Stations}"
                        SelectedIndex="{Binding StationSelectIndex}"
                        SelectedItem="{Binding StationSelectItem}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="通讯协议:" />
                    <TextBlock
                        x:Name="ProtocolTypeText"
                        VerticalAlignment="Center"
                        Text="{Binding StationProtocolType}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="交互类型:" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding InteractionType}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="数据名称:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding DataNames}" SelectedItem="{Binding DataNameSelectedItem}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="数据类型:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox
                        x:Name="DataTypeComboBox"
                        IsEnabled="{Binding IsDataTypeEnabled}"
                        ItemsSource="{Binding DataTypes}"
                        SelectedIndex="{Binding DataTypeIndex}"
                        SelectedItem="{Binding DataTypeSelectedItem}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,0,7"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Top">
                        <Run Text="数据地址:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <!--<TextBox Text="{Binding DataAddress, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" />-->
                    <ScrollViewer
                        Height="140"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
                        <c:DataAddressPanel
                            DataType="{Binding SelectedItem, ElementName=DataTypeComboBox}"
                            OutAddress="{Binding DataAddress,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            OutDataLength="{Binding DataLen,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            ProtocolType="{Binding Text, ElementName=ProtocolTypeText}" />
                    </ScrollViewer>
                </DockPanel>

                <!--
                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Text="长度:" />
                    <hc:NumericUpDown
                        HorizontalAlignment="Left"
                        Maximum="9999"
                        Minimum="1"
                        Value="{Binding DataLen}" />
                </DockPanel>-->

                <DockPanel Margin="0,15,0,0">
                    <TextBlock Margin="0,0,7,0" VerticalAlignment="Center">
                        <Run Text="数据方向:" />
                        <Run Foreground="Red" Text="*" />
                    </TextBlock>
                    <ComboBox
                        ItemsSource="{Binding DataDirections}"
                        SelectedIndex="{Binding DataDirectionIndex}"
                        SelectedItem="{Binding DataDirectionSelectedItem}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <CheckBox Content="是否启用" IsChecked="{Binding IsEnabled}" />
                </DockPanel>

                <DockPanel Margin="0,15,0,0">
                    <TextBlock
                        Margin="0,0,7,0"
                        VerticalAlignment="Top"
                        Text="备注:" />
                    <TextBox
                        Height="60"
                        AcceptsReturn="True"
                        Text="{Binding Remarks}"
                        TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Button
                Width="70"
                Height="35"
                Margin="150,0,0,13"
                Padding="8,3"
                HorizontalAlignment="Left"
                Command="{Binding AddCommand}"
                Content="新增"
                FontSize="13" />
            <Button
                Width="70"
                Height="35"
                Margin="0,0,150,13"
                Padding="8,3"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Content="取消"
                FontSize="13" />
        </Grid>
    </Grid>
</UserControl>
