<UserControl
    x:Class="DeviceModule.Views.Dialog.AddDeviceConnectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:ProductionLineManage.Shared.Controls;assembly=ProductionLineManage.Shared"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:DeviceModule.Views.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="1000"
    Height="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <!--  标题栏  -->
        <c:TitleBarControl
            FontIcon="&#xe6f3;"
            ShowMaximizeButton="False"
            ShowMinimizeButton="False"
            TitleName="{Binding Title}" />

        <!--  主要内容  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30">

                <!--  ===== 基本信息区域 =====  -->
                <Border
                    Margin="0,0,0,15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Text="基本信息" />

                        <StackPanel Orientation="Horizontal">
                            <!--  产线  -->
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Width="80" VerticalAlignment="Center">
                                    <Run Text="产线:" />
                                    <Run Foreground="Red" Text="*" />
                                </TextBlock>
                                <ComboBox
                                    Width="300"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding Lines}"
                                    SelectedIndex="{Binding LineSelectedIndex}"
                                    SelectedItem="{Binding LineSelectedItem}" />
                            </DockPanel>

                            <!--  工位  -->
                            <DockPanel Margin="80,10,0,0">
                                <TextBlock Width="80" VerticalAlignment="Center">
                                    <Run Text="工位:" />
                                    <Run Foreground="Red" Text="*" />
                                </TextBlock>
                                <ComboBox
                                    Width="300"
                                    DisplayMemberPath="DisplayText"
                                    IsEnabled="{Binding IsStationEnabled}"
                                    ItemsSource="{Binding Stations}"
                                    SelectedIndex="{Binding StationSelectedIndex}"
                                    SelectedItem="{Binding StationSelectedItem}" />
                            </DockPanel>
                        </StackPanel>


                        <!--  设备编码  -->
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock Width="80" VerticalAlignment="Center">
                                <Run Text="设备编码:" />
                                <Run Foreground="Red" Text="*" />
                            </TextBlock>
                            <TextBox
                                Width="300"
                                HorizontalAlignment="Left"
                                Text="{Binding DeviceCode}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  ===== 连接配置区域 =====  -->
                <Border
                    Margin="0,0,0,15"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="5">
                    <StackPanel Margin="15">
                        <TextBlock
                            Margin="0,0,0,10"
                            FontWeight="Bold"
                            Text="连接配置" />

                        <!--  连接模式  -->
                        <DockPanel Margin="0,15,0,0">
                            <TextBlock Width="100" VerticalAlignment="Center">
                                <Run Text="连接模式:" />
                                <Run Foreground="Red" Text="*" />
                            </TextBlock>
                            <RadioButton
                                Margin="0,0,15,0"
                                Content="分布式（独立连接）"
                                GroupName="ConnectionMode"
                                IsChecked="{Binding IsDistributedMode}" />
                            <RadioButton
                                Content="中央PLC（共享连接）"
                                GroupName="ConnectionMode"
                                IsChecked="{Binding IsCentralizedMode}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <!--  协议类型  -->
                            <DockPanel Margin="0,15,0,0">
                                <TextBlock Width="100" VerticalAlignment="Center">
                                    <Run Text="协议类型:" />
                                    <Run Foreground="Red" Text="*" />
                                </TextBlock>
                                <ComboBox
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding ProtocolTypes}"
                                    SelectedIndex="{Binding ProtocolTypeIndex}"
                                    SelectedItem="{Binding ProtocolTypeItem}" />
                            </DockPanel>

                            <!--  逻辑类型  -->
                            <DockPanel Margin="30,15,0,0">
                                <TextBlock Width="140" VerticalAlignment="Center">
                                    <Run Text="与设备交互逻辑类型:" />
                                    <Run Foreground="Red" Text="*" />
                                </TextBlock>
                                <ComboBox
                                    Width="200"
                                    HorizontalAlignment="Left"
                                    ItemsSource="{Binding LogicTypes}"
                                    SelectedIndex="{Binding LogicTypeIndex}"
                                    SelectedItem="{Binding LogicTypeItem}" />
                            </DockPanel>
                        </StackPanel>

                        <!--  SCADA 下发型号  -->
                        <DockPanel Margin="0,15,0,0">
                            <TextBlock
                                Width="140"
                                VerticalAlignment="Center"
                                Text="SCADA下发型号:" />
                            <CheckBox
                                VerticalAlignment="Center"
                                Content="启用（由软件向 PLC 下发型号）"
                                IsChecked="{Binding IsIssueModel}" />
                        </DockPanel>

                        <!--  连接地址  -->
                        <DockPanel Margin="0,15,0,0">
                            <TextBlock Width="100" VerticalAlignment="Center">
                                <Run Text="连接地址:" />
                                <Run Foreground="Red" Text="*" />
                            </TextBlock>
                            <local:ProtocolConnectionPanel Width="680" DataContext="{Binding ConnectionFields}" />
                        </DockPanel>

                        <StackPanel Orientation="Horizontal">
                            <!--  扫描周期  -->
                            <DockPanel Margin="0,15,0,0">
                                <TextBlock
                                    Width="100"
                                    VerticalAlignment="Center"
                                    Text="扫描周期(ms):" />
                                <hc:NumericUpDown
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Maximum="10000"
                                    Minimum="100"
                                    Value="{Binding ScanIntervalMs}" />
                            </DockPanel>

                            <!--  心跳间隔  -->
                            <DockPanel Margin="80,15,0,0">
                                <TextBlock
                                    Width="100"
                                    VerticalAlignment="Center"
                                    Text="心跳间隔(ms):" />
                                <hc:NumericUpDown
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Maximum="60000"
                                    Minimum="1000"
                                    Value="{Binding HeartbeatIntervalMs}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <!--  心跳超时  -->
                            <DockPanel Margin="0,15,0,0">
                                <TextBlock
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="心跳超时(ms):" />
                                <hc:NumericUpDown
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Maximum="120000"
                                    Minimum="1000"
                                    Value="{Binding HeartbeatTimeoutMs}" />
                            </DockPanel>

                            <!--  重连间隔  -->
                            <DockPanel Margin="80,15,0,0">
                                <TextBlock
                                    Width="100"
                                    VerticalAlignment="Center"
                                    Text="重连间隔(ms):" />
                                <hc:NumericUpDown
                                    Width="150"
                                    HorizontalAlignment="Left"
                                    Maximum="60000"
                                    Minimum="1000"
                                    Value="{Binding ReconnectIntervalMs}" />
                            </DockPanel>
                        </StackPanel>


                        <!--  是否启用  -->
                        <DockPanel Margin="0,15,0,0">
                            <CheckBox
                                Margin="105,0,0,0"
                                VerticalAlignment="Center"
                                Content="是否启用"
                                IsChecked="{Binding IsEnabled}" />
                        </DockPanel>
                        <!--  备注  -->
                        <DockPanel Margin="0,15,0,0">
                            <TextBlock
                                Margin="0,0,20,0"
                                VerticalAlignment="Center"
                                Text="备注:" />
                            <TextBox
                                Height="60"
                                AcceptsReturn="True"
                                Text="{Binding Remarks}"
                                TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>


            </StackPanel>
        </ScrollViewer>

        <!--  按钮  -->
        <Grid Grid.Row="2">
            <Button
                Width="70"
                Height="35"
                Margin="150,0,0,13"
                Padding="8,3"
                HorizontalAlignment="Left"
                Command="{Binding AddCommand}"
                Content="新增"
                FontSize="13" />
            <Button
                Width="70"
                Height="35"
                Margin="0,0,150,13"
                Padding="8,3"
                HorizontalAlignment="Right"
                Command="{Binding CancelCommand}"
                Content="取消"
                FontSize="13" />
        </Grid>
    </Grid>
</UserControl>