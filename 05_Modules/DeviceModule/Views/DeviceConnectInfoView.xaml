<UserControl
    x:Class="DeviceModule.Views.DeviceConnectInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dp="clr-namespace:ProductionLineManage.Shared.DependencyPropertys;assembly=ProductionLineManage.Shared"
    xmlns:local="clr-namespace:DeviceModule.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1. 标题  -->
        <Border
            Height="40"
            Margin="0,0,0,20"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="设备连接配置" />
        </Border>

        <!--  2. 筛选栏  -->
        <StackPanel
            Grid.Row="1"
            Margin="10"
            Orientation="Horizontal">
            <TextBlock
                Margin="25,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="Name"
                FontSize="15"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <TextBlock
                Margin="35,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="工位  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="DisplayText"
                FontSize="15"
                IsEnabled="{Binding IsStationEnabled}"
                ItemsSource="{Binding LineStations}"
                SelectedIndex="{Binding StationSelectedIndex}"
                SelectedItem="{Binding StationSelectedItem}" />

            <!--  新增按钮  -->
            <Button
                Height="auto"
                Margin="16,0,0,0"
                BorderThickness="0"
                Command="{Binding AddCommand}"
                Content="&#xe6f3;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />

            <!--  刷新按钮  -->
            <Button
                Height="auto"
                Margin="16,0,0,0"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                Content="&#x10232;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />
        </StackPanel>

        <!--  3. 设备连接列表  -->
        <DataGrid
            x:Name="dgDevices"
            Grid.Row="2"
            Margin="10"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CellStyle="{StaticResource DataGridCellStyle1}"
            ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle1}"
            IsReadOnly="True"
            ItemsSource="{Binding DeviceConfigs, Mode=OneWay}"
            RowHeaderWidth="0"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.Columns>
                <!--  ID  -->
                <DataGridTextColumn
                    Width="50"
                    Binding="{Binding Id, Mode=OneWay}"
                    Header="Id" />

                <!--  工位名称  -->
                <DataGridTextColumn
                    Width="180"
                    Binding="{Binding StationName, Mode=OneWay}"
                    Header="工位名称" />

                <!--  设备编码  -->
                <DataGridTextColumn
                    Width="120"
                    Binding="{Binding DeviceCode, Mode=OneWay}"
                    Header="设备编码" />

                <!--  协议类型  -->
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding ProtocolType, Mode=OneWay}"
                    Header="协议类型" />

                <!--  交互类型  -->
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding InteractionType, Mode=OneWay}"
                    Header="交互类型" />


                <!--  连接模式  -->
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding ConnectionMode, Mode=OneWay}"
                    Header="连接模式" />

                <!--  连接地址  -->
                <DataGridTextColumn
                    Width="500"
                    Binding="{Binding ConnectionString, Mode=OneWay}"
                    Header="连接地址" />

                <!--  扫描周期  -->
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding ScanIntervalMs, Mode=OneWay}"
                    Header="扫描(ms)" />

                <!--  心跳间隔  -->
                <DataGridTextColumn
                    Width="80"
                    Binding="{Binding HeartbeatIntervalMs, Mode=OneWay}"
                    Header="心跳(ms)" />

                <!--  是否启用  -->
                <DataGridTemplateColumn Width="70" Header="启用">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                IsHitTestVisible="False" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!--  操作列  -->
                <DataGridTemplateColumn Width="140" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <!--  编辑按钮  -->
                                <Button
                                    Width="50"
                                    Margin="2"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="编辑"
                                    FontSize="12" />

                                <!--  删除按钮  -->
                                <Button
                                    Width="50"
                                    Margin="2"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="删除"
                                    FontSize="12" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>

</UserControl>
