<UserControl
    x:Class="DeviceModule.Views.InteractiveEventsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  日志级别转颜色  -->
            <SolidColorBrush x:Key="InfoBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FF9800" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F44336" />

            <!--  日志级别样式  -->
            <Style x:Key="LevelInfoStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InfoBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="LevelWarningStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>
            <Style x:Key="LevelErrorStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                <Setter Property="FontWeight" Value="Bold" />
            </Style>

            <!--  日志行样式  -->
            <Style x:Key="LogRowStyle" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F5F5" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--  1. 标题  -->
        <Border
            Height="40"
            Margin="0,0,0,20"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="交互事件日志" />
        </Border>

        <!--  2. 筛选栏  -->
        <WrapPanel
            Grid.Row="1"
            Margin="0,0,0,15"
            HorizontalAlignment="Left">

            <!--  产线筛选  -->
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                Text="产线  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="Name"
                FontSize="14"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <!--  工位筛选  -->
            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                Text="工位  " />
            <ComboBox
                Width="180"
                DisplayMemberPath="DisplayText"
                FontSize="14"
                ItemsSource="{Binding Stations}"
                SelectedIndex="{Binding StationSelectedIndex}"
                SelectedItem="{Binding StationSelectedItem}" />

            <!--  日期筛选  -->
            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                Text="日期  " />
            <!--  TimeVisibility="Collapsed"  -->
            <hc:DateTimePicker
                Width="140"
                FontSize="14"
                SelectedDateTime="{Binding SelectedDate}" />

            <!--  级别筛选  -->
            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="14"
                Text="级别  " />
            <ComboBox
                Width="100"
                FontSize="14"
                ItemsSource="{Binding LevelFilters}"
                SelectedIndex="{Binding LevelFilterIndex}"
                SelectedItem="{Binding LevelFilterItem}" />

            <!--  操作按钮  -->
            <Button
                Margin="15,0,0,0"
                Padding="12,6"
                Command="{Binding QueryCommand}"
                Content="查询"
                FontSize="14" />

            <Button
                Margin="5,0,0,0"
                Padding="12,6"
                Command="{Binding RefreshCommand}"
                Content="刷新"
                FontSize="14" />

            <!--  实时刷新开关  -->
            <CheckBox
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                Content="实时刷新"
                FontSize="13"
                IsChecked="{Binding IsAutoRefreshEnabled}" />
        </WrapPanel>

        <!--  3. 日志列表  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LogEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LogRowStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  时间  -->
                                <TextBlock
                                    Grid.Column="0"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{Binding TimeDisplay}" />

                                <!--  级别  -->
                                <TextBlock
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Style="{Binding LevelStyle}"
                                    Text="{Binding Level}" />

                                <!--  设备编码  -->
                                <TextBlock
                                    Grid.Column="2"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="Gray"
                                    Text="{Binding DeviceCode}" />

                                <!--  消息内容  MaxWidth="1500"-->
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <TextBox
                                        
                                        BorderThickness="0"
                                        FontSize="12"
                                        IsReadOnly="True"
                                        Text="{Binding Message, Mode=OneWay}"
                                        TextWrapping="NoWrap" 
                                        HorizontalScrollBarVisibility="Auto"
                                        VerticalScrollBarVisibility="Auto"/>
                                    <Button
                                        Margin="10,0,0,0"
                                        Padding="8,2"
                                        Command="{Binding DataContext.ShowDetailCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="详情"
                                        FontSize="11"
                                        Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  4. 分页栏  -->
        <Border
            Grid.Row="3"
            Margin="0,15,0,0"
            Padding="10"
            Background="#F9F9F9"
            CornerRadius="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="Gray"
                    Text="{Binding TotalCountText}" />

                <StackPanel
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding FirstPageCommand}"
                        Content="首页" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding PreviousPageCommand}"
                        Content="上一页" />
                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{Binding PageInfo}" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding NextPageCommand}"
                        Content="下一页" />
                    <Button
                        Margin="5,0"
                        Padding="8,5"
                        Command="{Binding LastPageCommand}"
                        Content="末页"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>