<UserControl
    x:Class="DeviceModule.Views.DeviceDashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProductionLineManage.Shared;component/Assets/Styles/Dictionary1.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  连接状态颜色转换器  -->
            <SolidColorBrush x:Key="StatusOnlineBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="StatusOfflineBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="StatusConnectingBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="StatusErrorBrush" Color="#F44336" />

            <!--  运行状态颜色  -->
            <SolidColorBrush x:Key="RunStateRunningBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="RunStateIdleBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="RunStateStoppedBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="RunStateAlarmBrush" Color="#F44336" />
            <SolidColorBrush x:Key="RunStateMaintenanceBrush" Color="#FF9800" />

            <!--  卡片样式  -->
            <Style x:Key="DeviceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#E0E0E0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Margin" Value="10" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Width" Value="400" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect
                            BlurRadius="5"
                            Opacity="0.1"
                            ShadowDepth="2" />
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  折叠器样式  -->
            <Style x:Key="ExpanderHeaderStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="#F5F5F5" />
                <Setter Property="Foreground" Value="#333333" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="15,12" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="{TemplateBinding Content}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="10,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="Gray"
                                        Text="{Binding ElementName=StatusText, Path=Text}"
                                        TextAlignment="Right" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        FontSize="14"
                                        Text="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ExpandCollapseConverter}}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  1. 标题  -->
        <Border
            Height="40"
            Margin="0,0,0,20"
            Padding="10"
            VerticalAlignment="Top"
            Background="White">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="18"
                FontWeight="Bold"
                Text="设备看板" />
        </Border>

        <!--  2. 筛选栏  -->
        <WrapPanel
            Grid.Row="1"
            Margin="10"
            HorizontalAlignment="Left">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="15"
                Text="产线  " />
            <ComboBox
                Width="150"
                DisplayMemberPath="Name"
                FontSize="14"
                ItemsSource="{Binding Lines}"
                SelectedIndex="{Binding LineSelectedIndex}"
                SelectedItem="{Binding LineSelectedItem}" />

            <TextBlock
                Margin="15,0,0,0"
                VerticalAlignment="Center"
                FontSize="15"
                Text="状态  " />
            <ComboBox
                Width="120"
                FontSize="14"
                ItemsSource="{Binding StatusFilters}"
                SelectedIndex="{Binding StatusFilterIndex}"
                SelectedItem="{Binding StatusFilterItem}" />

            <!--  刷新按钮  -->
            <Button
                Height="auto"
                Margin="16,0,0,0"
                BorderThickness="0"
                Command="{Binding RefreshCommand}"
                Content="&#x10232;"
                FontFamily="{StaticResource fontFamily1}"
                FontSize="23"
                Foreground="#1485FF" />

            <!--  自动刷新指示  -->
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="Gray"
                Text="{Binding RefreshStatus}" />
            <Button
                Margin="30,0,0,0"
                Command="{Binding ConnectAllCommand}"
                Content="启动所有连接"
                Visibility="{Binding CanStartAllConnect, Converter={StaticResource BoolToVisibility}}" />
            <Button
                Margin="30,0,0,0"
                Command="{Binding DisconnectAllCommand}"
                Content="断开所有连接"
                />
            <!--Visibility="{Binding CanStopAllConnect, Converter={StaticResource BoolToVisibility}}" -->
        </WrapPanel>

        <!--  3. 看板内容（可滚动，按产线折叠）  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding LineGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--  产线折叠器  -->
                        <Expander
                            Margin="0,0,0,10"
                            BorderBrush="#E0E0E0"
                            BorderThickness="0,0,0,1"
                            IsExpanded="{Binding IsExpanded}">

                            <!--  折叠器标题  -->
                            <Expander.Header>
                                <Border
                                    Padding="15,12"
                                    Background="#F5F5F5"
                                    CornerRadius="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  产线名称  -->
                                        <TextBlock
                                            Grid.Column="0"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{Binding LineName}" />
                                        <!--  基本信息  -->
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0"
                                            FontSize="12"
                                            Foreground="Gray"
                                            Text="{Binding StatusSummary}"
                                            TextAlignment="Right" />
                                        <!--  展开/隐藏图标  -->
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            FontSize="14"
                                            Text="{Binding IsExpanded, Converter={StaticResource ExpandCollapseConverter}}" />
                                    </Grid>
                                </Border>
                            </Expander.Header>

                            <!--  该产线下的工位卡片（WrapPanel自动换行）  -->
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel HorizontalAlignment="Center" Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DeviceCardStyle}">
                                            <StackPanel>
                                                <!--  工位名称 和 状态栏  -->
                                                <Grid Margin="0,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal">
                                                        <!--  状态图标  -->
                                                        <TextBlock
                                                            Margin="0,-4,8,0"
                                                            FontSize="18"
                                                            Foreground="{Binding ConnectionStateColor}"
                                                            Text="{Binding ConnectionStateIcon}" />

                                                        <!--  连接状态文字  -->
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{Binding ConnectionStateColor}"
                                                            Text="{Binding ConnectionStateText}"
                                                            TextAlignment="Right" />
                                                    </StackPanel>

                                                    <StackPanel>
                                                        <!--  工位和设备信息  -->
                                                        <TextBlock
                                                            Margin="0,5,0,2"
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Text="{Binding StationName}" />
                                                        <TextBlock
                                                            Margin="0,0,0,5"
                                                            FontSize="12"
                                                            Foreground="Gray"
                                                            Text="{Binding DeviceCode}" />
                                                    </StackPanel>
                                                </Grid>

                                                <Border
                                                    Height="1"
                                                    Margin="0,5"
                                                    Background="#E0E0E0" />

                                                <!--  运行状态  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="运行状态:" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Ellipse
                                                            Width="8"
                                                            Height="8"
                                                            Margin="0,0,5,0"
                                                            Fill="{Binding RunStateColor}" />
                                                        <TextBlock
                                                            FontSize="12"
                                                            Foreground="{Binding RunStateColor}"
                                                            Text="{Binding RunStateText}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  流水码  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="流水码:" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding CurrentFlowCode}" />
                                                </Grid>

                                                <!--  今日产量  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="今日产量:" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        FontWeight="Bold"
                                                        Text="{Binding TodayProcessedCount}" />
                                                </Grid>

                                                <!--  当前型号 Visibility="{Binding HasProductType, Converter={StaticResource BoolToVisibility}}"  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="当前型号:" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Text="{Binding ProductTypeName}" />
                                                </Grid>

                                                <!--  工单号  Visibility="{Binding HasWorkOrder, Converter={StaticResource BoolToVisibility}}"  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="工单号:" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontFamily="Consolas"
                                                        FontSize="12"
                                                        Text="{Binding WorkOrder}" />
                                                </Grid>

                                                <!--  设备最后请求指令  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="请求指令:" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Text="{Binding DeviceLastCommand}" />
                                                        <TextBlock
                                                            Margin="20,0,0,0"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Text="{Binding LastDeviceCommandTime}" />
                                                    </StackPanel>

                                                </Grid>

                                                <!--  回复指令  Visibility="{Binding HasLastCommand, Converter={StaticResource BoolToVisibility}}"  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="回复指令:" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Text="{Binding LastCommand}" />
                                                        <TextBlock
                                                            Margin="20,0,0,0"
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Text="{Binding LastCommandTime}" />
                                                    </StackPanel>
                                                </Grid>

                                                <!--  最后通讯时间  -->
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Grid.Column="0"
                                                        Margin="0,0,10,0"
                                                        HorizontalAlignment="Right"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="最后通讯:" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="11"
                                                        Foreground="Gray"
                                                        Text="{Binding LastHeartbeatDisplay}" />
                                                </Grid>

                                                <!--  错误信息  -->
                                                <Border
                                                    Margin="0,10,0,0"
                                                    Padding="8,5"
                                                    Background="#FFEBEE"
                                                    CornerRadius="4"
                                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="#F44336"
                                                        Text="{Binding LastError}"
                                                        TextWrapping="Wrap" />
                                                </Border>

                                                <!--  手动连接断开按钮  -->
                                                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                                    <Button
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.ConnectStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="连接"
                                                        FontSize="11"
                                                        Visibility="{Binding CanConnect, Converter={StaticResource BoolToVisibility}}" />
                                                    <Button
                                                        Margin="5,0,0,0"
                                                        Padding="8,4"
                                                        Command="{Binding DataContext.DisconnectStationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="断开"
                                                        FontSize="11"
                                                        Visibility="{Binding CanDisconnect, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>